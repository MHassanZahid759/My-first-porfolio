# =========================================================================
# PORTFOLIO CONFIGURATION - ENVIRONMENT VARIABLES (.env)
# =========================================================================
# Rename this file to '.env' and fill in your details for local testing.
# Never commit your actual '.env' file to GitHub!

# Backend Port (Default is 5000)
PORT=5000

# Admin Portal secret password
ADMIN_PASSWORD=your_secure_admin_password

# Gmail credentials for sending contact messages to you
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

